{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://security-commons-nl.github.io/normen/schema.json",
 "title": "Kader in normen",
 "description": "Een normbron van Security Commons NL: een kop met herkomst en vingerafdruk, en een lijst records. Een kader draagt nummers, titels en thema's en waar de bron dat toestaat de tekst van de maatregel zelf; nooit normtekst van een auteursrechthebbende buiten de overheid.",
 "type": "object",
 "required": ["kader", "titel", "versie", "toelichting", "bron", "vingerafdruk"],
 "properties": {
  "kader": {"type": "string", "pattern": "^[a-z0-9-]+$"},
  "titel": {"type": "string", "minLength": 1},
  "versie": {"type": "string", "minLength": 1},
  "toelichting": {"type": "string", "minLength": 1},
  "bron": {
   "type": "object",
   "required": ["naam", "versie", "licentie", "opgehaald"],
   "properties": {
    "naam": {"type": "string", "minLength": 1},
    "versie": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "licentie": {"type": "string", "minLength": 1},
    "opgehaald": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "herkomst": {"type": "string"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "let_op": {"type": "string"}
   },
   "additionalProperties": true
  },
  "tweede_etiket": {
   "type": "object",
   "required": ["kader", "toelichting"],
   "properties": {"kader": {"type": "string"}, "toelichting": {"type": "string"}},
   "additionalProperties": false
  },
  "vingerafdruk": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "maatregelen": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
  "domeinen": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/domein"}}
 },
 "oneOf": [
  {"required": ["maatregelen"], "not": {"required": ["domeinen"]}},
  {"required": ["domeinen"], "not": {"required": ["maatregelen"]}}
 ],
 "additionalProperties": false,
 "$defs": {
  "record": {
   "type": "object",
   "required": ["id", "titel"],
   "properties": {
    "id": {"type": "string", "minLength": 1},
    "titel": {"type": "string", "minLength": 1},
    "thema": {"type": "string"},
    "artikel": {"type": "string"},
    "kern": {"type": "string"},
    "overheidsmaatregel": {"type": "string"},
    "risico": {"type": "string"}
   },
   "additionalProperties": false
  },
  "domein": {
   "type": "object",
   "required": ["id", "titel", "omschrijving", "controls"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "titel": {"type": "string", "minLength": 1},
    "omschrijving": {"type": "string", "minLength": 1},
    "controls": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\d+\\.\\d{2}\\.\\d{2}$"}}
   },
   "additionalProperties": false
  }
 }
}
